{
  "order": ["psalter", "marquee"],
  "styles": {
    "psalter": {
      "name": "Psalter",
      "tags": ["classic"],
      "layout": {
        "type": "box",
        "color": "background",
        "padding": 14,
        "child": {
          "type": "box",
          "border": "accentDim",
          "borderWidth": 0.8,
          "padding": 4,
          "child": {
            "type": "box",
            "border": "accent",
            "borderWidth": 1.6,
            "padding": {"horizontal": 24, "vertical": 28},
            "child": {
              "type": "column",
              "cross": "stretch",
              "gap": 14,
              "children": [
                {
                  "type": "text",
                  "text": "{reference}",
                  "upper": true,
                  "font": "syne",
                  "weight": 700,
                  "size": 8.5,
                  "tracking": 0.25,
                  "color": "accent",
                  "align": "center"
                },
                {
                  "type": "row",
                  "main": "center",
                  "gap": 8,
                  "children": [
                    {"type": "box", "width": 26, "height": 0.8, "color": "accentDim"},
                    {"type": "box", "width": 5, "height": 5, "circle": true, "color": "accent"},
                    {"type": "box", "width": 26, "height": 0.8, "color": "accentDim"}
                  ]
                },
                {
                  "type": "align",
                  "flex": 1,
                  "alignment": "center",
                  "child": {
                    "type": "text",
                    "fit": true,
                    "font": "cormorant",
                    "italic": true,
                    "weight": 500,
                    "size": 26,
                    "height": 1.18,
                    "align": "center"
                  }
                },
                {
                  "type": "text",
                  "text": "{translation}",
                  "font": "mono",
                  "size": 7.5,
                  "tracking": 0.3,
                  "color": "accentDim",
                  "align": "center"
                }
              ]
            }
          }
        }
      },
      "variants": [
        {"id": "night", "name": "Night", "background": "#14110F", "ink": "#F2E9D8", "accent": "#C9A24A", "accent_dim": "#7A6331"},
        {"id": "vellum", "name": "Vellum", "background": "#F3EBDA", "ink": "#2A2119", "accent": "#A8322A", "accent_dim": "#C9A27A"},
        {"id": "lapis", "name": "Lapis", "background": "#16224F", "ink": "#EEF0FA", "accent": "#D9B65C", "accent_dim": "#6E7BB0"}
      ]
    },
    "marquee": {
      "name": "Marquee",
      "tags": ["bold"],
      "layout": {
        "type": "stack",
        "children": [
          {"type": "box", "color": "background"},
          {"type": "halftone", "color": "ink@0.1", "spacing": 8},
          {
            "type": "padding",
            "padding": {"horizontal": 24, "vertical": 30},
            "child": {
              "type": "column",
              "cross": "start",
              "children": [
                {
                  "type": "rotate",
                  "degrees": -4,
                  "child": {
                    "type": "box",
                    "color": "surface",
                    "border": "border",
                    "borderWidth": 2,
                    "padding": {"horizontal": 10, "vertical": 4},
                    "child": {
                      "type": "text",
                      "text": "{referenceLine}",
                      "font": "mono",
                      "weight": 700,
                      "size": 9,
                      "color": "surfaceInk"
                    }
                  }
                },
                {
                  "type": "byShape",
                  "default": {"type": "space", "size": 18},
                  "story": {"type": "space", "size": 48}
                },
                {
                  "type": "align",
                  "flex": 1,
                  "alignment": "bottomLeft",
                  "child": {
                    "type": "text",
                    "fit": true,
                    "upper": true,
                    "font": "grotesk",
                    "weight": 800,
                    "condensed": true,
                    "size": 40,
                    "height": 0.92,
                    "tracking": -0.02
                  }
                },
                {"type": "space", "size": 16},
                {"type": "box", "width": 64, "height": 6, "color": "accent"}
              ]
            }
          }
        ]
      },
      "variants": [
        {"id": "lime", "name": "Lime", "background": "#D9F75B", "ink": "#10133F", "accent": "#2433D6", "surface": "#10133F", "surface_ink": "#D9F75B", "border": "#10133F"},
        {"id": "tomato", "name": "Tomato", "background": "#FF5A36", "ink": "#1A0E0A", "accent": "#FFF1E0", "surface": "#FFF1E0", "surface_ink": "#1A0E0A", "border": "#1A0E0A"}
      ]
    }
  }
}
