default_platform(:android)

ROOT = File.expand_path("../..", __dir__)
AAB = File.join(ROOT, "build/app/outputs/bundle/release/app-release.aab")
TRACKS = %w[internal alpha beta production].freeze

# The +N of `version:` in pubspec.yaml, which becomes the Play version code.
def pubspec_build
  File.read(File.join(ROOT, "pubspec.yaml"))[/^version:\s*\S+\+(\d+)/, 1].to_i
end

platform :android do
  desc "Build the release bundle and upload it to Play."
  desc "Options: track (alpha = closed testing, internal, production), status (completed, draft), skip_build, dry_run"
  lane :release do |options|
    build = pubspec_build
    used = play_version_codes.max || 0
    if build <= used
      UI.user_error!("pubspec.yaml build #{build} is not above #{used}, the highest version code on Play. Bump the +N in pubspec.yaml.")
    end
    unless options[:skip_build]
      Dir.chdir(ROOT) { sh("flutter", "build", "appbundle", "--release") }
    end
    upload_to_play_store(
      aab: AAB,
      track: options[:track] || "alpha",
      release_status: options[:status] || "completed",
      validate_only: options[:dry_run] ? true : false,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Print the version codes on each Play track."
  lane :version_codes do
    TRACKS.each do |track|
      UI.message("#{track}: #{google_play_track_version_codes(track: track).inspect}")
    end
  end

  desc "Check that the service account key can reach Play."
  lane :check_key do
    validate_play_store_json_key
  end

  private_lane :play_version_codes do
    TRACKS.flat_map do |track|
      google_play_track_version_codes(track: track)
    rescue StandardError
      []
    end
  end
end
